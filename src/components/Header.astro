---
import LanguageSwitcher from "@/components/LanguageSwitcher.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import { ui, type Lang, type PageKey } from "@/i18n/ui";
import { localizedPath } from "@/i18n/utils";

interface Props {
  lang: Lang;
  page: PageKey;
  current: PageKey | undefined;
}

const { lang, page, current } = Astro.props;
const { nav } = ui[lang];
const links = (Object.keys(nav.items) as (keyof typeof nav.items)[]).map((key) => ({
  key,
  label: nav.items[key],
  href: localizedPath(lang, key),
}));
---

<header class="site-header">
  <div class="container bar">
    <a
      class="brand"
      href={localizedPath(lang, "home")}
      aria-current={current === "home" ? "page" : undefined}
    >
      Clément Rieux
    </a>
    <nav aria-label={nav.label}>
      <ul class="nav">
        {links.map((link) => (
          <li>
            <a href={link.href} aria-current={current === link.key ? "page" : undefined}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="tools">
      <LanguageSwitcher lang={lang} page={page} />
      <ThemeToggle lang={lang} />
    </div>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    padding-block: var(--space-2);
  }

  .brand {
    font-weight: 700;
    color: var(--text);
    text-decoration: none;
    margin-right: auto;
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav a {
    display: inline-block;
    padding-block: var(--space-2);
    color: var(--text);
    text-decoration: none;
  }

  .nav a[aria-current="page"] {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-decoration-color: var(--accent);
  }

  .tools {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  @media (max-width: 40rem) {
    .bar {
      gap: var(--space-1) var(--space-3);
    }

    nav[aria-label] {
      order: 3;
      width: 100%;
    }
  }
</style>
