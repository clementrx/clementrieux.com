---
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import { LANGS, OG_LOCALES, ui, type Lang, type PageKey } from "@/i18n/ui";
import { localizedPath } from "@/i18n/utils";
import "@/styles/tokens.css";
import "@/styles/global.css";

interface Props {
  lang: Lang;
  /** Page being rendered; undefined for pages without language versions (404). */
  page?: PageKey;
  title: string;
  description: string;
}

const { lang, page, title, description } = Astro.props;
const site = Astro.site;
if (!site) throw new Error("`site` must be set in astro.config.mjs to build absolute URLs.");

const absolute = (path: string) => new URL(path, site).href;
const canonical = page ? absolute(localizedPath(lang, page)) : undefined;
const ogImage = absolute(`/og-${lang}.jpg`);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {page &&
      LANGS.map((code) => (
        <link rel="alternate" hreflang={code} href={absolute(localizedPath(code, page))} />
      ))}
    {page && (
      <link rel="alternate" hreflang="x-default" href={absolute(localizedPath("en", page))} />
    )}
    {!page && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Clément Rieux" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={OG_LOCALES[lang]} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline>
      try {
        const saved = localStorage.getItem("theme");
        if (saved === "light" || saved === "dark") document.documentElement.dataset.theme = saved;
      } catch {
        // Storage can be unavailable (private mode); fall back to the system theme.
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">
      {ui[lang].skipLink}
    </a>
    <Header lang={lang} page={page ?? "home"} current={page} />
    <main id="content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
